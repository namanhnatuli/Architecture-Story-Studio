{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture-story-studio/schemas/states.schema.json",
  "type": "object",
  "required": ["building_type", "shared_components", "variants", "transitions"],
  "properties": {
    "building_type": {"type": "string"},
    "shared_components": {"type": "array", "items": {"type": "string"}},
    "variants": {"type": "array", "minItems": 2, "items": {
      "type": "object", "required": ["id", "name", "roof_pitch_degrees", "color_key"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "roof_pitch_degrees": {"type": "number", "minimum": 5, "maximum": 70},
        "color_key": {"type": "string"}
      }, "additionalProperties": false
    }},
    "transitions": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["from", "to", "template"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "template": {"enum": ["REPLACE_PARTS", "STATE_TRANSITION", "SIDE_BY_SIDE", "ASSEMBLE", "DISASSEMBLE"]}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
