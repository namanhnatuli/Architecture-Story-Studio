{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_plan.schema.json",
  "title": "Visual execution plan (M5)",
  "description": "Deterministic output of planner/planner.py; validated by planner/validate.py; compiled to storyboard/states.json + storyboard.json by planner/compiler.py. Reproducible without re-planning.",
  "type": "object",
  "required": [
    "schema",
    "plan_version",
    "planner_version",
    "project_id",
    "timing_mode",
    "fps",
    "total_frames",
    "executable",
    "inputs",
    "states",
    "shots",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "visual_plan/1"
    },
    "plan_version": {
      "type": "string"
    },
    "planner_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "timing_mode": {
      "enum": [
        "PROVISIONAL",
        "AUDIO_LOCKED"
      ]
    },
    "fps": {
      "type": "integer"
    },
    "total_frames": {
      "type": "integer"
    },
    "duration_seconds": {
      "type": "number"
    },
    "executable": {
      "type": "boolean"
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "type": "object",
      "description": "sha256 of beats, sources, vocabulary, planning config and every used asset spec"
    },
    "states": {
      "type": "object",
      "description": "states.json the plan compiles to"
    },
    "resolutions": {
      "type": "array"
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "beat_id",
          "visual_intent",
          "strategy",
          "template",
          "states",
          "camera",
          "timing",
          "semantic_targets",
          "cut_from_previous",
          "shot",
          "evidence_status"
        ],
        "properties": {
          "shot_id": {
            "type": "string"
          },
          "beat_id": {
            "type": "string"
          },
          "part": {
            "type": "array"
          },
          "visual_intent": {
            "type": "string"
          },
          "strategy": {
            "type": "string"
          },
          "template": {
            "enum": [
              "HOLD",
              "EXPLODED_VIEW",
              "REPLACE_PARTS",
              "SIDE_BY_SIDE",
              "MOTION_GRAPHICS"
            ]
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset_ids": {
            "type": "array"
          },
          "semantic_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "concept",
                "component_ids"
              ]
            }
          },
          "camera": {
            "type": "object",
            "required": [
              "mode",
              "preset",
              "group"
            ]
          },
          "timing": {
            "type": "object",
            "required": [
              "mode",
              "frames",
              "duration_seconds",
              "min_seconds",
              "start_seconds"
            ]
          },
          "cut_from_previous": {
            "enum": [
              "first",
              "match",
              "hard"
            ]
          },
          "evidence_status": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "visibility": {
            "type": [
              "object",
              "null"
            ],
            "description": "M5.5 Level 1 estimate at the explanatory frames (planner/visibility.py)",
            "properties": {
              "frames": {
                "type": "object"
              },
              "explanatory": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "concept": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "frame": {
                      "type": "integer"
                    },
                    "visible_share": {
                      "type": "number"
                    },
                    "core_area": {
                      "type": "number"
                    },
                    "visible_area": {
                      "type": "number"
                    },
                    "projected_area": {
                      "type": "number"
                    },
                    "safe_band_share": {
                      "type": "number"
                    },
                    "outside_share": {
                      "type": "number"
                    },
                    "occluders": {
                      "type": "array"
                    },
                    "components": {
                      "type": "object"
                    },
                    "geometry": {
                      "enum": [
                        "MESH",
                        "PROXY"
                      ]
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "verification": {
                      "enum": [
                        "ESTIMATED",
                        "UNCERTAIN"
                      ]
                    },
                    "problems": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "OCCLUDED",
                          "TOO_SMALL",
                          "CLIPPED",
                          "SUBTITLE_SAFE_AREA",
                          "PIECES_HIDDEN",
                          "NOT_SHOWN"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "shot": {
            "type": "object",
            "description": "the storyboard shot (engine contract) this plan entry compiles to"
          },
          "repairs": {
            "type": "array",
            "description": "Visual repairs written into the shot (planner/repair.py)",
            "items": {
              "type": "object",
              "required": [
                "concept",
                "remedy",
                "problems"
              ],
              "properties": {
                "concept": {
                  "type": "string"
                },
                "remedy": {
                  "type": "string",
                  "pattern": "^(REFRAME|SAFE_BAND|ALT_CAMERA:.+|GHOST:.+)$"
                },
                "problems": {
                  "type": "array"
                },
                "before": {
                  "type": "object"
                },
                "after": {
                  "type": "object"
                }
              }
            }
          },
          "composition": {
            "type": [
              "object",
              "null"
            ],
            "description": "Comparison layout decision (planner/composition.py)",
            "properties": {
              "layout": {
                "enum": [
                  "SIDE_BY_SIDE_STACK",
                  "SIDE_BY_SIDE_ROW",
                  "SEQUENTIAL_COMPARISON"
                ]
              },
              "gap_ratio": {
                "type": "number"
              },
              "label_band": {
                "type": "number"
              },
              "purpose": {
                "enum": [
                  "detail",
                  "overview"
                ]
              },
              "scale": {
                "enum": [
                  "COMMON",
                  "NORMALIZED"
                ]
              },
              "sequence": {
                "type": "array"
              },
              "metrics": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "candidates": {
                "type": "array"
              }
            }
          },
          "sequence": {
            "type": [
              "string",
              "null"
            ],
            "description": "Shots of one sequential comparison share one locked camera"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "beat_id",
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "COVERED",
              "PARTIALLY_COVERED",
              "MISSING_ASSET",
              "MISSING_TEMPLATE",
              "TIMING_CONFLICT",
              "EVIDENCE_BLOCKED",
              "INVALID_REQUEST"
            ]
          },
          "visual_repairs": {
            "type": "array",
            "description": "Every visibility problem found and the remedies evaluated (chosen or null)"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visibility_summary": {
      "type": "object",
      "description": "M5.5 Level 1 visibility: shots assessed, target rows passing, issues detected, auto-repaired, manual review, uncertain rows."
    },
    "pieces_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vocabulary concepts read as separate pieces (read_as: pieces)."
    }
  }
}
