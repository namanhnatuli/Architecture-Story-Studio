{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture-story-studio/schemas/storyboard.schema.json",
  "type": "object",
  "required": [
    "shots"
  ],
  "properties": {
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start_seconds",
          "duration_seconds",
          "visual_purpose",
          "narration",
          "claim_ids",
          "visual_type",
          "from_state",
          "to_state",
          "transition",
          "camera"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SC_[0-9]{3,}$"
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "visual_purpose": {
            "type": "string",
            "minLength": 8
          },
          "narration": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_type": {
            "enum": [
              "BLENDER_3D",
              "ARCHIVAL",
              "MAP",
              "MOTION_GRAPHICS"
            ]
          },
          "from_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "transition": {
            "type": "string",
            "description": "Must equal animation.template when animation is present."
          },
          "camera": {
            "type": "string"
          },
          "animation": {
            "type": "object",
            "description": "Template config; options per template are defined (with defaults) in engine/motion.py and documented in docs/05_ANIMATION_LIBRARY.md. Unknown options are rejected by the validator.",
            "required": [
              "template"
            ],
            "properties": {
              "template": {
                "enum": [
                  "HOLD",
                  "REPLACE_PARTS",
                  "EXPLODED_VIEW",
                  "SIDE_BY_SIDE"
                ]
              }
            }
          },
          "cut_from_previous": {
            "enum": [
              "match",
              "hard"
            ],
            "description": "match (default): the cut from the previous shot must be invisible (media QA SSIM >= 0.98); hard: deliberate visible cut."
          },
          "beat_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "M3: narration beats played during this shot"
          },
          "graphic": {
            "type": "object",
            "description": "M3: MOTION_GRAPHICS card (text/arrow elements in 0..1 card units)"
          },
          "camera_focus": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "M5 COMPONENT_CLOSEUP: component ids the locked camera is fitted to (single-model shots)."
          },
          "camera_safe_band": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.4,
            "description": "M5: bottom fraction of the frame kept free (subtitles) in single-model shots."
          },
          "build_variants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "M5: variants built in a single-model shot (one continuity group sharing a locked camera); default: every variant."
          },
          "editorial": {
            "type": "object",
            "description": "Non-visual planning metadata (planner/, M5): beat, intent, strategy, evidence; never a render dependency."
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "key_stills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "shot"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "shot": {
            "type": "string"
          },
          "time_seconds": {
            "type": [
              "number",
              "string"
            ],
            "description": "number, or a narration anchor in the template"
          },
          "marker": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "generated_by": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
