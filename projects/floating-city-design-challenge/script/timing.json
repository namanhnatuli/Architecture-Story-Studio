{
  "schema": "timing/2",
  "mode": "PLANNED_AUDIO_LOCK",
  "stage": "BEATS_LOCKED",
  "fps": 24,
  "pacing": {
    "sentence_pause_seconds": 0.4,
    "beat_lead_in_seconds": 0.4,
