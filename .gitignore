.DS_Store
__pycache__/
*.pyc
.venv/
*.log
*.blend1
*.blend2
projects/*/renders/**
projects/*/output/**
projects/*/scenes/*.blend
!projects/*/renders/.gitkeep
!projects/*/output/.gitkeep

# --- M2.5: generated media, caches, local settings ---
# QA evidence images/videos are regenerated by `tools/cli.py preview`; reports (*.md, *.json) stay tracked.
projects/*/qa/**/*.png
# M3.5 before/after review images are deliverables (small, not regenerable from git)
!projects/*/qa/m35_before_after/*.png
projects/*/qa/**/*.mp4
projects/*/qa/**/*.tar.gz
projects/*/scenes/*.blend@
*.blend@
*.tmp
.pytest_cache/
*.egg-info/
# Local secrets / machine settings (never commit)
.env
.env.*
.claude/settings.local.json
projects/*/qa/**/*.blend
projects/*/qa/**/*.blend1

# --- M3: narration audio ---
# Canonical TTS takes (audio/segments/*.wav, audio/voice/*.wav) ARE tracked: generation is
# stochastic and the timing lock references their hashes. Everything below is rebuilt
# deterministically from them by `narrate` (beats) and `assemble` (tracks, mixes).
projects/*/audio/beats/
projects/*/audio/narration_track_*.wav
projects/*/audio/narration_mix_*.wav

# --- M4: asset previews (JPEG copies are tracked; PNG originals are local) ---
asset_library/architecture/**/previews/**/*.png
asset_library/catalog/qa/*.log

# --- M6: voice audition (WAV/parts are rebuilt deterministically by tools/voice_audition.py;
# the .m4a listening copies, metrics.json and AUDITION.md are tracked) ---
projects/*/review/voice_audition/*.wav
projects/*/review/voice_audition/parts/
