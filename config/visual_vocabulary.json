{
  "schema": "visual_vocabulary/1",
  "note": "Narrative concepts -> what they mean visually. kind: site | architecture | component. architecture: family/variant (+ 'where' parameter predicates; 'supported': false = known concept without a generator). component: semantic roles (engine/arch component role = semantic type in lower case; legacy house/roof roles as built by engine/geometry.py). 'ambiguous_if_multiple': the concept matches several roles in one asset and must be made specific. 'ghost_roles': roles of the parts that normally cover this component (deck planks over stringers); they turn see-through while it glows (HOLD highlight.ghost). Used by planner/ (M5).",
  "concepts": {
    "river_crossing_site": {"kind": "site", "family": "site", "variant": "river_crossing", "label": "Site with a gap to span"},
    "timber_beam_bridge":  {"kind": "architecture", "family": "bridge", "variant": "timber_beam", "label": "Timber beam bridge"},
    "beam_bridge":         {"kind": "architecture", "family": "bridge", "variant": "timber_beam", "label": "Beam bridge (timber example)"},
    "stone_arch_bridge":   {"kind": "architecture", "family": "bridge", "variant": "stone_arch", "label": "Stone arch bridge"},
    "five_arch_stone_bridge": {"kind": "architecture", "family": "bridge", "variant": "stone_arch", "where": {"arch_count": 5}, "label": "Stone arch bridge, five arches"},
    "steel_truss_bridge":  {"kind": "architecture", "family": "bridge", "variant": "steel_truss", "where": {"truss_pattern": "pratt"}, "label": "Steel truss bridge"},
    "pratt_truss":         {"kind": "architecture", "family": "bridge", "variant": "steel_truss", "where": {"truss_pattern": "pratt"}, "label": "Pratt truss"},
    "warren_truss":        {"kind": "architecture", "family": "bridge", "variant": "steel_truss", "where": {"truss_pattern": "warren"}, "label": "Warren truss"},
    "suspension_bridge":   {"kind": "architecture", "family": "bridge", "variant": "suspension", "supported": false, "label": "Suspension bridge"},
    "cable_stayed_bridge": {"kind": "architecture", "family": "bridge", "variant": "cable_stayed", "supported": false, "label": "Cable-stayed bridge"},
    "cantilever_bridge":   {"kind": "architecture", "family": "bridge", "variant": "cantilever", "supported": false, "label": "Cantilever bridge"},
    "house_with_gable_roof": {"kind": "architecture", "family": "roof", "variant": "gable_roof", "label": "House with a gable roof"},
    "low_pitch_gable_roof":  {"kind": "architecture", "family": "roof", "variant": "gable_roof", "where": {"roof_pitch_degrees": {"max": 30}}, "label": "Low-pitched gable roof"},
    "steep_gable_roof":      {"kind": "architecture", "family": "roof", "variant": "gable_roof", "where": {"roof_pitch_degrees": {"min": 40}}, "label": "Steep gable roof"},

    "voussoir":        {"kind": "component", "roles": ["voussoir"], "label": "voussoirs"},
    "keystone":        {"kind": "component", "roles": ["keystone"], "label": "keystones"},
    "arch_ring":       {"kind": "component", "roles": ["voussoir", "keystone"], "label": "arch rings"},
    "spandrel":        {"kind": "component", "roles": ["spandrel"], "label": "spandrel fill"},
    "pier":            {"kind": "component", "roles": ["pier"], "label": "piers"},
    "abutment":        {"kind": "component", "roles": ["abutment"], "label": "abutments"},
    "parapet":         {"kind": "component", "roles": ["parapet", "coping"], "label": "parapets"},
    "deck":            {"kind": "component", "roles": ["deck", "plank"], "label": "deck"},
    "deck_planks":     {"kind": "component", "roles": ["plank"], "label": "deck planks"},
    "stringer":        {"kind": "component", "roles": ["stringer"], "ghost_roles": ["plank"], "label": "stringers (primary beams)"},
    "primary_beams":   {"kind": "component", "roles": ["stringer"], "ghost_roles": ["plank"], "label": "primary beams"},
    "cap_beam":        {"kind": "component", "roles": ["cap_beam"], "label": "cap beams"},
    "trestle_bent":    {"kind": "component", "roles": ["support"], "label": "trestle bents"},
    "railing":         {"kind": "component", "roles": ["railing"], "label": "railings"},
    "truss_chord":     {"kind": "component", "roles": ["truss_chord"], "label": "chords"},
    "end_post":        {"kind": "component", "roles": ["end_post"], "label": "end posts"},
    "vertical_members": {"kind": "component", "roles": ["truss_vertical"], "label": "vertical members"},
    "diagonal_members": {"kind": "component", "roles": ["truss_diagonal"], "label": "diagonal members"},
    "truss_web":       {"kind": "component", "roles": ["truss_vertical", "truss_diagonal"], "label": "truss web"},
