    "roof_covering":   {"kind": "component", "roles": ["roof_covering"], "label": "roof covering"},
    "rafters":         {"kind": "component", "roles": ["rafters"], "ghost_roles": ["roof_covering"], "label": "rafters"},
    "ridge_beam":      {"kind": "component", "roles": ["ridge_beam"], "ghost_roles": ["roof_covering"], "label": "ridge beam"},
    "gable_wall":      {"kind": "component", "roles": ["gable_wall"], "label": "gable walls"},
    "roof_structure":  {"kind": "component", "roles": ["gable_wall", "rafters", "ridge_beam"], "label": "roof structure"}
  }
